{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zuikaku-volunteer-certificate-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zuikaku-volunteer-profiles",
      "database_id": "fc88f974-f526-4b20-a98a-8cf4b4ca63c4",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CERTIFICATE_ASSETS",
      "bucket_name": "zuikaku-certificate-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "DISCORD_GATEWAY", "class_name": "DiscordGateway" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DiscordGateway"] }
  ]
}
